        let currentLang = 'ckb';
        function setLanguage(lang) {
            currentLang = lang;
            const data = i18n[lang];

            // Direction and Fonts
            document.documentElement.setAttribute('lang', lang);
            document.documentElement.setAttribute('dir', data.dir);
            document.body.setAttribute('dir', data.dir);

            // Active button state
            document.querySelectorAll('.lang-btn').forEach(btn => {
                const isSelected = (lang === 'ckb' && btn.innerText.includes('کوردی')) ||
                                   (lang === 'ar' && btn.innerText.includes('عراقي')) ||
                                   (lang === 'en' && btn.innerText.trim() === 'EN');
                btn.classList.toggle('active', isSelected);
            });

            // Update UI static elements
            document.getElementById('hana-name').innerText = data.name;
            document.getElementById('hana-title').innerText = data.title;
            document.getElementById('messageInput').placeholder = data.placeholder;

            // Render Quick Replies
            renderQuickReplies();

            // Clear chat and add localized welcome
            const chatBody = document.getElementById('chatBody');
            chatBody.innerHTML = '';
            appendMessage('bot', data.welcome);
        }

        function renderQuickReplies() {
            const container = document.getElementById('quickReplies');
